# Site Manager API key with Network scope. Required.
UNIFI_API_KEY=

# Optional overrides
# This host receives the API key. Keep the default unless you test against a
# local stub. https only (http only for 127.0.0.1, [::1] or localhost), and an
# origin without path, query or fragment; anything else stops the server.
UNIFI_API_BASE=https://api.ui.com
# Default true: write/delete tools return a redacted preview and only execute
# when called again with confirm: "YES". Only false/0/no/off (any case) turn
# this off; an empty or unknown value keeps it on (unknown values log a warning).
UNIFI_CONFIRM_WRITES=true
UNIFI_TIMEOUT_MS=30000
UNIFI_LOG_LEVEL=info
# Optional opt-ins, off by default:
# true: write tools refuse without sending a request (reads still work).
UNIFI_READ_ONLY=false
# true: secret-looking fields in tool results are replaced by (redacted).
UNIFI_REDACT_SECRETS=false
# A positive integer cuts longer tool results to that many bytes; empty: no cap.
UNIFI_MAX_RESULT_BYTES=

# Optional: skip discovery if you know the IDs
UNIFI_CONSOLE_ID=
UNIFI_NETWORK_SITE_ID=
UNIFI_SITE_MANAGER_SITE_ID=
